# Output or work folders
output/
work/
emg/
debug/

# Simulation files
*.vcd
*.vvp
*.log
*.out
*.dump

# Compiled simulation binaries (regenerable)
rtl_sim_snn_lp

# Simulation output (regenerated on every run, in any dataset folder)
*/inference_out.txt

# Dataset files extracted from the zip but NOT used by the snn_lp testbench
# (regenerated by `make prepare_data`; only the 8 essential files are tracked)
*/current_buffer_*.txt
*/current_partials_*.txt
*/weights_*.txt
*/address.txt
*/samples.txt
*/constants.h
*/input_vec.txt

# Dataset archives (kept out of the repo; provided via DATA_ZIP)
*.zip

# Temporary files
*.tmp
*.swp
*.bak
*.~*

# System files
.DS_Store
Thumbs.db

# Backups and cache
*.pyc
__pycache__/
.cache/
*.class

# Local configuration files
.env
*.local

# Visual Studio Code
.vscode/
work/tb_serv.vcd
